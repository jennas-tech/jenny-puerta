# Jarvis Jennas — estación wake word (17-oct-2026)
# El modelo custom 'jenny' entrenado en la casa con 10 voces del catálogo
# (dataset wake-dataset/, split por voz, FP@0.5 val = 0.000%).
# El swap de vuelta al prototipo hey_jarvis: comentar acá y reiniciar.
JARVIS_WAKE_MODELO=wake-models/jenny_custom_v0.1.onnx
JARVIS_WAKE_UMBRAL=0.9
JARVIS_WAKE_FIN_SIL_MS=2500
# Grabación POST-despertar: 12 s de tope (17-oct-2026, Tavo: «dale más tiempo
# para decir cosas más largas») — el corte REAL sigue siendo el fin-de-habla de
# 2.5 s de silencio sostenido; este tope solo tapa frases que no paran nunca.
JARVIS_WAKE_GRABAR=12.0
# MODO «explayándose» (17-oct 19:05, Tavo: «no permite explayarme mucho»):
# si la VOZ REAL del turno pasó de 3 s, el fin-de-habla crece de 2.5 s a 9 s —
# las pausas de pensamiento caben; los llamados cortos siguen cortando a 2.5 s.
JARVIS_WAKE_VOZ_EXPLAYA_MS=3000
JARVIS_WAKE_GRACIA_MS=9000
# TOPE DE CALMA (17-oct 19:20, Tavo: «me corta cuando estoy hablando»): el tope
# de 12 s solo cierra turnos con silencio reciente — si la voz sigue, el tope se
# estira +4 s por ventana. Techo (17-oct 19:31, Tavo: «me sigue cortando»): los
# re-contamientos de sus sueños viven en turnos de 30-36 s — el techo de 33 le
# CORTABA con voz en mano («…y me quería [seguir]»), y era MAYOR que el ring
# (36 s), que botaba el ARRANQUE del clip → STT decapitado («también está esa…»).
# Regla aritmética: ring >= tope-duro + pre-2.4 → 2000 chunks (160 s) cubre 150+2.4 ✓
JARVIS_WAKE_TOPE_DURO_S=150.0
# MODO «explayándose» INHABILITADO (17-oct 19:52, Tavo: «lo único que sería mejor
# inhabilitar por ahora es el detector de silencios largos, el problema era cortar
# el habla, no el silencio»): el bip por pausa y el corte-gracia de 9 s van OFF —
# el fin-de-habla vuelve FLAT a FIN_SIL_MS (2.5 s). Reversibilidad: borrar esta
# línea y reiniciar.
JARVIS_WAKE_MODO_EXPLAYA=off
